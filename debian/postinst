#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Global hotkeys require the installing user to be in the 'input' group
    # (to read /dev/input/event*). We do NOT grant this automatically: 'input'
    # membership is a powerful capability — it grants read access to ALL input
    # devices (system-wide keystroke-capture capability) and, via the bundled
    # udev rule, write access to /dev/uinput (synthetic input injection), for
    # every process that user runs. The user must opt in explicitly.
    if [ -n "$SUDO_USER" ] && ! id -nG "$SUDO_USER" 2>/dev/null | grep -qw input; then
        echo "frogscribe: Global hotkeys need '$SUDO_USER' in the 'input' group, which is NOT"
        echo "frogscribe:   granted automatically. WARNING: 'input' membership allows reading"
        echo "frogscribe:   ALL input devices (system-wide keylogging capability) and writing"
        echo "frogscribe:   /dev/uinput (input injection). Grant it only if you accept that:"
        echo "frogscribe:       sudo usermod -aG input $SUDO_USER"
        echo "frogscribe:   then log out and back in. See T4 in the FrogScribe threat model."
    fi

    # Migrate away from any previous *system* ydotoold service. It used a
    # world-writable /tmp socket (0666), which let any local process inject
    # synthetic input — see T3 in the threat model. Remove it and its drop-in.
    if [ -f /etc/systemd/system/ydotoold.service ]; then
        systemctl disable --now ydotoold.service 2>/dev/null || true
        rm -f /etc/systemd/system/ydotoold.service
    fi
    rm -f /etc/systemd/system/ydotool.service.d/socket-perms.conf \
          /usr/lib/systemd/system/ydotool.service.d/socket-perms.conf
    rm -f /tmp/.ydotool_socket
    systemctl daemon-reload 2>/dev/null || true

    # Enable the per-user ydotoold service for all users. Its socket lives in
    # $XDG_RUNTIME_DIR with 0600 perms (user-private). Starts at next login.
    systemctl --global enable ydotoold.service 2>/dev/null || true

    # Ensure uinput module is loaded (required by ydotoold)
    if ! lsmod | grep -q uinput; then
        modprobe uinput || true
    fi
    if [ ! -f /etc/modules-load.d/uinput.conf ]; then
        echo "uinput" > /etc/modules-load.d/uinput.conf
    fi

    # Reload udev rules for /dev/uinput permissions
    udevadm control --reload-rules && udevadm trigger
    echo "frogscribe: udev rules reloaded for /dev/uinput"

    echo "frogscribe: ydotoold runs as a per-user service; it will start at your next login."
fi

#DEBHELPER#
